{% extends 'single.twig' %}

{% block styles %}
  <link rel='stylesheet' id='mjf-feed-css' href='{{theme.link}}/public/feed/css/mjf.min.css' type='text/css' media='all' />
{% endblock %}

{% block header %}
  <!-- overhang header -->
  <header class="site-header homer">
    <div class="rmcc-position-relative rmcc-position-z-index rmcc-light">
      <div class="rmcc-position-top rmcc-margin-top">
        <nav class="rmcc-navbar-container rmcc-navbar-transparent">
          <div class="rmcc-container rmcc-container-xlarge">
            <div class="rmcc-visible@l" rmcc-grid>

              {# company menu #}
              <div class="rmcc-width-expand rmcc-visible@l">
                {% include 'header/company_menu.twig' %}
              </div>
              
              {# secondary menu #}
              <div class="rmcc-width-auto">
                <div>
                  {% include 'header/secondary_menu.twig' %}
                </div>
              </div>

            </div>
            <div rmcc-navbar="" class="rmcc-navbar rmcc-margin-small-top">

              {# left logo #}
              <div class="rmcc-navbar-left pull-left-5">
                <a class="rmcc-navbar-item rmcc-logo" href="/">
                  <div class="rmcc-grid-collapse rmcc-grid-match rmcc-flex rmcc-flex-middle rmcc-grid" rmcc-grid="">
                    {% include 'header/logo.twig' %}
                  </div>
                </a>
              </div>

              {# right menu/s #}
              <div class="rmcc-navbar-right">
                {% include 'header/main_menu.twig' %}
              </div>
              
            </div>
          </div>
        </nav>
      </div>
    </div>
  </header>
{% endblock %}

{% block main %}
  <article id="{{ post.id|e('esc_html') }}" class="{{ post.class|e('esc_html') }}" data-template="cover.twig">
    
    {% block single_header %}
    {% endblock %}
    
    {% block single_content %}
      <div class="single-content">
        {% block single_content_editor %}
          <div class="content-editor gutenberg-editor">
            {{ post.content|e('wp_kses_post') }}
          </div>
        {% endblock %}
      </div>
    {% endblock %}

    {% block single_footer %}
    {% endblock %}
  
  </article>
{% endblock %}

{% block footer %}
  <!-- footer dark bg -->
  <footer class="site-footer curved-upper rmcc-background-secondary rmcc-light">
    <div class="rmcc-container rmcc-section">

      <!-- footer top -->
      <div rmcc-grid>

        <!-- footer top one -->
        {% include 'footer/footer_menu_1.twig' %}

        <!-- footer top two -->
        {% include 'footer/footer_menu_2.twig' %}

        <!-- footer top three -->
        {% include 'footer/footer_menu_3.twig' %}

        <!-- footer top four -->
        {% include 'footer/footer_menu_4.twig' %}

        <!-- footer top five -->
        {% include 'footer/footer_col_5.twig' %}

      </div>

      <!-- footer divider -->
      <hr class="rmcc-margin-medium rmcc-margin-large-top">

      <!-- footer bottom -->
      <div class="bottom-footer rmcc-grid-collapse rmcc-flex rmcc-flex-middle" rmcc-grid>
        <div class="rmcc-width-medium@m rmcc-flex rmcc-flex-center rmcc-flex-left@m">© 2025 Kilbeggan Community Group CLG. All rights reserved.</div>
          
        {# secondary menu #}
        <div class="rmcc-width-1-1 rmcc-width-expand@m rmcc-flex rmcc-flex-center rmcc-text-center">
          {% include 'footer/footer_secondary_menu.twig' %}
        </div>

        {# socials menu #}
        <div class="rmcc-width-1-1 rmcc-width-small@m rmcc-width-medium@l rmcc-flex rmcc-flex-center rmcc-flex-right@m">
          {% include 'footer/footer_socials_menu.twig' %}
        </div>

      </div>
      
    </div>
  </footer>

  <!-- mobile offcanvas -->
  {% include 'footer/mobile_offcanvas.twig' %}

  <!-- search popup -->
  {% include 'footer/search_popup.twig' %}
  
  <script src="{{theme.link}}/public/feed/js/mjf.min.js"></script>
  <script src="{{theme.link}}/public/feed/js/feed.js"></script>
  <script>
    (async function () {
      var jobsJson = await fetchJobsJson('https://feed.midlandjobs.ie/demo/');
      var jobsQ = JsonQuery(jobsJson); //Initialize the Query Engine
      var kilbegganJobs = jobsQ.where({'company': 'Kilbeggan Community Group'}).exec();
      const MyJobsObject = new JobBoardFilteredFeed(42, kilbegganJobs, {

        pagination: {
          visiblePages: 3, // set init visible pages within the pagination
          initPerPage: 3, // set an initial per page count (in case where perPage below is false/not set)
          perPage: {
            values: [3, 5] // per page dropdown options
          },
        },

        filters: [
          {
            key: 'city',
            singular: 'Town/City',
            plural: 'Cities',
            type: 'option',
            setArray: false,
            removeTerms: []
          },
          {
            key: 'category',
            singular: 'Category',
            plural: 'Categories',
            type: 'checkbox',
            setArray: true,
            removeTerms: []
          }
        ],

      });
      MyJobsObject.renderTheJobs('#MyJobs');
    })();
  </script>
{% endblock %}