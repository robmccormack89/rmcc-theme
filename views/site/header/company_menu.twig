  {% if fn('has_nav_menu', 'company_menu') %}
    <div class="rmcc-grid-small rmcc-grid-divider rmcc-flex-middle rmcc-text-small rmcc-grid" rmcc-grid>
      {% for item in menu_company.get_items %}
        <div class="rmcc-width-auto">
          {% if item.link != '#' %}<a href="{{ item.link|e('esc_url') }}">{% endif %}
            <span class="rmcc-text-meta">{{ item.title|e('wp_kses_post')}}</span>
          {% if item.link != '#' %}</a>{% endif %}
        </div>
      {% endfor %}
    </div>
  {% endif %}