<div class="rmcc-width-1-1 rmcc-width-expand@s">
  <form>
    <fieldset class="rmcc-fieldset">

      <legend class="rmcc-legend">Subscribe to our newsletter!</legend>

      <div class="rmcc-margin-small">
        <input class="rmcc-input rmcc-border-rounded rounded-more" type="text" placeholder="Your Email Address" aria-label="Input">
      </div>
  
      <div class="rmcc-margin-small">
        <select class="rmcc-select rmcc-border-rounded rounded-more" aria-label="Select">
          <option>-- Please Select Country --</option>
          <option>Ireland</option>
        </select>
      </div>

      <div class="rmcc-margin rmcc-flex rmcc-flex-center">
        <a class="rmcc-button rmcc-button-default rmcc-button-gradient rmcc-border-rounded" href="#">Add me</a>
      </div>

    </fieldset>
  </form>
</div>