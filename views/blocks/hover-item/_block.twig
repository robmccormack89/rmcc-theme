<div class="rmcc-width-1-2@m">
  <div class="rmcc-hover-block rmcc-inline-clip rmcc-transition-toggle rmcc-light" tabindex="0">
    <div>
      <img src="{{theme.link}}/public/images/resource-card.jpg" class="rmcc-height-large cover" width="1800" height="1800" alt="">
      <div class="rmcc-position-cover {{block.controls.classes|join(' ')}}">
        <div class="rmcc-position-top-left rmcc-padding-large rmcc-width-1-1">
          <div class="rmcc-position-relative">
            <div class="rmcc-width-5-6">
              {% set content %}
                {% block block_content %}
                  Nothing here....
                {% endblock %}
              {% endset %}
              {{content}}
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="rmcc-transition-fade rmcc-position-cover">
      <img src="{{theme.link}}/public/images/resource-building.jpg" class="rmcc-height-large cover" width="1800" height="1800" alt="">
      <div class="rmcc-position-cover {{block.controls.classes|join(' ')}}">
        <div class="rmcc-position-center rmcc-text-center rmcc-padding">
          {{content}}
        </div>
      </div>
    </div>
  </div>
</div>