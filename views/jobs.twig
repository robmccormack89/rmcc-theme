{% extends 'custom.twig' %}

{% block styles %}
  {{ parent() }}
  {% if not fn('is_admin') %}
    <!--FEED: css -->
    <link href="https://cdn.jsdelivr.net/gh/midlandjobs/insite-feeds@dynamo/public/css/mjf.min.css" rel="stylesheet">
  {% endif %}
{% endblock %}

{% block single_content %}
  {{ parent() }}
  <!--FEED: html -->
  <div class="mjf-wrap">
    <div class="jobs-wrap mjf-container mjf-section-small">
      <div id="MyJobs">Loading...</div>
    </div>
    <div class="mjf-empty"></div>
  </div>
{% endblock %}

{% block scripts %}
  {{ parent() }}
  {% if not fn('is_admin') %}
    <!--FEED: js (as close to (but above) the closing body tag as possible) -->
    <script src="https://cdn.jsdelivr.net/gh/midlandjobs/insite-feeds@dynamo/public/js/mjf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/midlandjobs/insite-feeds@dynamo/public/js/api/feed.js"></script>
    <script>
      (async function () {
        var jobsJson = await fetchJobsJson('https://feed.midlandjobs.ie/demo/');
        var jobsQ = JsonQuery(jobsJson); //Initialize the Query Engine
        var kinnegadJobs = jobsQ.where({'company': 'Kinnegad Combined Community Employment Scheme'}).exec();
        const MyJobsObject = new JobBoardFilteredFeed(42, kinnegadJobs, {
  
          // counts: true,
          // search: true,

          pagination: {
            visiblePages: 3, // set init visible pages within the pagination
            initPerPage: 3, // set an initial per page count (in case where perPage below is false/not set)
            perPage: {
              values: [3, 5] // per page dropdown options
            },
          },

          filters: [
            {
              key: 'city',
              singular: 'Town/City',
              plural: 'Cities',
              type: 'option',
              setArray: false,
              removeTerms: []
            },
            {
              key: 'jobtype',
              singular: 'Jobtype',
              plural: 'Jobtypes',
              type: 'option',
              setArray: true,
              removeTerms: []
            },
            {
              key: 'category',
              singular: 'Category',
              plural: 'Categories',
              type: 'checkbox',
              setArray: true,
              removeTerms: []
            }
          ],

          // pagination: false,

          // filters: [
          //   {
          //     key: 'company',
          //     singular: 'Company',
          //     plural: 'Companies',
          //     type: 'option',
          //     setArray: false,
          //     removeTerms: []
          //   },
          //   {
          //     key: 'jobtype',
          //     singular: 'Jobtype',
          //     plural: 'Jobtypes',
          //     type: 'option',
          //     setArray: true,
          //     removeTerms: []
          //   },
          //   {
          //     key: 'city',
          //     singular: 'Town/City',
          //     plural: 'Cities',
          //     type: 'option',
          //     setArray: false,
          //     removeTerms: []
          //   },
          //   {
          //     key: 'remote',
          //     singular: 'Remote',
          //     plural: 'Remotes',
          //     type: 'option',
          //     setArray: false,
          //     removeTerms: []
          //   },
          //   {
          //     key: 'category',
          //     singular: 'Category',
          //     plural: 'Categories',
          //     type: 'checkbox',
          //     setArray: true,
          //     removeTerms: []
          //   }
          // ],

          // counts: false,
          // search: false,
          // filters: false

        });
        MyJobsObject.renderTheJobs('#MyJobs');
      })();
    </script>
  {% endif %}
{% endblock %}