{% block single_content %}
  <div id="my_nanogallery"></div>
  <script>
    jQuery(document).ready(function () {
      jQuery("#my_nanogallery").nanogallery2({
        thumbnailWidth:   'auto',
        thumbnailHeight:  150,
        kind:             'nano_photos_provider2',
        dataProvider:     'https://testwp.com/wp-content/themes/rmcc-theme/inc/lib/nanogallery/nano_photos_provider2.php',
        locationHash:     false
      });
    });
  </script>
