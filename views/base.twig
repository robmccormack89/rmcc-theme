{% block html_head_container %}

  {% include 'html_head.twig' %}
    {% block styles %}
    {% endblock %}
  </head>
  {% endblock %}

  <body class="{{ body_class }} rmcc-background-muted {{ (configs.darklight) ? 'rmcc-light' : 'rmcc-dark' }}" data-template="base.twig">

    {% block header %}
      {% include 'header.twig' ignore missing %}
    {% endblock %}

    <main id="Main" role="main">
      {% block main %}
        <div class="rmcc-section-default">
          <div class="rmcc-container rmcc-container-xsmall">
            <h1>{{ title|e('esc_html') }}</h1>
            <p>{{ description|e('esc_html') }}</p>
            {% include (fn('is_404') or fn('get_post_status', post.id) == 'private') ? 'search_form.twig' ignore missing %}
          </div>
        </div>
      {% endblock %}
    </main>

    {% block footer %}
      {% include 'footer.twig' ignore missing %}
    {% endblock %}

    {{ fn('wp_footer') }}

    {% if fn('has_nav_menu', 'main_menu') %}
      {% include 'header/offcanvas.twig' %}
    {% endif %}

    {# search popup #}
    <div id="modal-search" class="rmcc-modal-full rmcc-modal" rmcc-modal>
      <div class="rmcc-modal-dialog rmcc-flex rmcc-flex-center rmcc-flex-middle rmcc-background-muted" rmcc-height-viewport>
        <button class="rmcc-modal-close-full" type="button" rmcc-icon="icon: close; ratio: 2"></button>
        <form id="form_validate_search" class="rmcc-search rmcc-search-large" role="search" method="get" action="{{ site.url|e('esc_url') }}" accept-charset="utf-8" novalidate="novalidate">
          <input 
          id="input_search" class="rmcc-search-input rmcc-text-center" type="search" name="s" maxlength="300" pattern=".*\S+.*" 
          placeholder="{{ _x('Start searching...', 'Search: form', 'rmcc-theme')|e('esc_html') }}"
          aria-label="{{ _x('Start searching...', 'Search: form', 'rmcc-theme')|e('esc_html') }}"
          autocomplete="off" autooofocus value required />
          <input type="hidden" name="post_type" value="post" />
        </form>
      </div>
    </div>

    {% block scripts %}
    {% endblock %}

    {# watch the darklight btns for mouseovers... #}
    <script>
      document.querySelectorAll('.darklight-btn').forEach(item => {
        item.addEventListener('mousedown', event => {

          event.preventDefault(); // prevent default events from propagating

          var darklightCookie = getCookie("darklight"); // get cookie value at point of mouseover

          // if darklightCookie not set, UNSET any dark style
          if(darklightCookie != "" && darklightCookie != null) {
            lightMode();
            showDarkBtn();
          }
          // else we SET the dark style
          else {
            darkMode();
            showLightBtn();
          }

        })
      })
    </script>

  </body>

</html>