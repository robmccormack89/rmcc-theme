{% if fn('has_nav_menu', 'footer_menu_1') %}
  <div class="rmcc-width-1-2 rmcc-width-1-6@s">
    <ul class="rmcc-nav rmcc-nav-default">
      <li class="rmcc-nav-header rmcc-text-bold rmcc-h4 rmcc-margin-remove">{{ menu_footer_1.title|e('esc_html') }}</li>
      {% for item in menu_footer_1.get_items %}
        <li class="{{ item.classes|join(' ')|e('esc_html') }}">
          <a href="{{ item.link|e('esc_url') }}">
            {{ item.title|e('wp_kses_post')}}
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
{% endif %}