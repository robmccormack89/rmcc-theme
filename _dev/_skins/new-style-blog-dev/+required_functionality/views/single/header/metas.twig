{% if (post.date or post.categories or fn('get_post_meta', post.id, 'read_time', true)) and (post.post_type == 'post') %}
  <div class="article-meta rmcc-article-meta dotted-subs rmcc-margin-small-top">

    {% if post.date %}
      {% set dated = fn('human_time_diff', fn('get_the_time', 'U'), fn('current_time', 'timestamp'))|e('esc_html') %}
      <span class="post-date">
        <span rmcc-icon="icon: file-edit; ratio: 1"></span> {{ _x('%s ago', 'Single: meta date', 'rmcc-theme')|e('esc_html')|format(dated) }}
      </span>
    {% endif %}

    {% if post.categories %}
      <span class="post-cats">
        <span rmcc-icon="icon: folder; ratio: 1"></span>
        {% for term in post.terms({query:{taxonomy:'category', orderby:'name', order: 'ASC'}}) %}
          <a title="{{ term|e('esc_html') }}" href="{{ term.link|e('esc_url') }}">{{ term|e('esc_html') }}</a>{{ loop.last ? '' : ', ' }}
        {% endfor %}
      </span>
    {% endif %}

    {% if post.meta('read_time') %}
      <span class="post-read-time">
        <span rmcc-icon="icon: clock; ratio: 1"></span> {{ post.meta('read_time')|e('esc_html') }}
      </span>
    {% endif %}
    
  </div>
{% endif %}