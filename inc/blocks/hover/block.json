{
  "name": "acf/rmcc-hover",
  "title": "RMcC Hover",
  "description": "A hover block built using ACF & Timber/Twig.",
  "category": "rmcc",
  "icon": "admin-comments",
  "keywords": ["rmcc", "hover"],
  "style": ["file:./hover.css"],

  "acf": {
    "blockVersion": 3,
    "renderTemplate": "hover.php"
  },

  "example": {
    "attributes": {
      "preview": true
    }
  },

  "supports": {
    "mode": true,
    "jsx": true,

    "html": true,
    "anchor": false,
    "multiple": true,

    "className": false,
    "customClassName": true,
    "inserter": true,
    "reusable": true,
    "lock": true,

    "align": false,

    "typography": {
      "lineHeight": false
    },

    "background": {
      "backgroundImage": false,
      "backgroundSize": false
    },
    "color": {
      "text": false,
      "background": false,
      "gradients": false
    }
    
  }

}