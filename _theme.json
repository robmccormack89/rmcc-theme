{
  "version": 2,

  "settings": {
    "appearanceTools": true,

    "spacing": {
      "margin": true,
      "padding": true
    },

    "layout": {
      "contentSize": "750px",
      "wideSize": "1200px"
    },

    "typography": {
      "customFontSize": true,
      "defaultFontSizes": true,
      "dropCap": true,

      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "13px"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "20px"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "36px"
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "42px"
        }
      ],

      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": false,
      "textAlign": true,
      "textDecoration": true,
      "textTransform": true,
      "writingMode": false,

      "fontFamilies": [
        {
          "name": "Primary",
          "slug": "primary",
          "fontFamily": "-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,\"Noto Sans\",sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\",\"Segoe UI Symbol\",\"Noto Color Emoji\""
        },
        {
          "name": "Secondary",
          "slug": "secondary",
          "fontFamily": "system-ui, sans-serif"
        },
				{
					"fontFamily": "\"Fredoka\", sans-serif",
					"name": "Fredoka",
					"slug": "fredoka",
					"fontFace": [
						{
							"fontFamily": "Fredoka",
							"fontWeight": "300",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [ "file:./public/fonts/fredoka-v16-latin-300.woff2" ]
						},
						{
							"fontFamily": "Fredoka",
							"fontWeight": "regular",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [ "file:./public/fonts/fredoka-v16-latin-regular.woff2" ]
						},
						{
							"fontFamily": "Fredoka",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [ "file:./public/fonts/fredoka-v16-latin-500.woff2" ]
						},
						{
							"fontFamily": "Fredoka",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [ "file:./public/fonts/fredoka-v16-latin-600.woff2" ]
						},
						{
							"fontFamily": "Fredoka",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [ "file:./public/fonts/fredoka-v16-latin-700.woff2" ]
						}
					]
				}
      ]
    }
  },

  "styles": {
    "typography": {
      "__fontFamily": "var(--wp--preset--font-family--primary)",
      "fontSize": "18px"
    },
    "elements": {
      "link": {
        "typography": {
          "textDecoration": "none"
          }
      }
    }
  }
}